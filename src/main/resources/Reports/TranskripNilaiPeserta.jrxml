                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8.5" isItalic="true"/></textElement>
                <text><![CDATA[Belum ada data nilai seleksi atau hasil kuis yang tercatat untuk peserta ini.]]></text>
            </staticText>

            <!-- Kartu Ringkasan & Validasi di Kiri -->
            <rectangle radius="6">
                <reportElement mode="Opaque" x="0" y="28" width="275" height="66" backcolor="#F8FAFC" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.7" lineColor="#CBD5E1"/></graphicElement>
