<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TranskripNilaiPeserta" language="java" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="id_peserta" class="java.lang.String"/>

    <!--
        Perubahan dari versi sebelumnya (setelah migrasi ke MySQL):
        1. nama_lengkap diambil dari tabel pengguna (alias pg), bukan dari tabel peserta.
        2. Blok pertama memakai LEFT JOIN ke seleksi: peserta tanpa data seleksi tetap menghasilkan
           1 baris (kolom evaluasi NULL) sehingga kop laporan tetap terisi. Baris kosong itu
           disembunyikan di bagian detail lewat printWhenExpression.
    -->
    <queryString>
        <![CDATA[
        SELECT
            p.id_peserta,
            p.nik,
            pg.nama_lengkap,
            p.kelas,
            p.level_bahasa,
            p.status_seleksi,
            COALESCE(pr.nama_program, '-') AS nama_program,
            'Tes Seleksi' AS kategori,
            s.jenis_seleksi AS nama_evaluasi,
            s.tanggal_seleksi AS tanggal,
            CAST(s.nilai AS CHAR) AS skor,
            s.status_hasil AS status_evaluasi,
            '-' AS catatan
        FROM peserta p
        JOIN pengguna pg ON pg.username = p.username
        LEFT JOIN program pr ON p.id_program = pr.id_program
        LEFT JOIN seleksi s ON s.id_peserta = p.id_peserta
        WHERE p.id_peserta = $P{id_peserta}

        UNION ALL

        SELECT
            p.id_peserta,
            p.nik,
            pg.nama_lengkap,
            p.kelas,
            p.level_bahasa,
            p.status_seleksi,
            COALESCE(pr.nama_program, '-') AS nama_program,
            'Kuis Kelas' AS kategori,
            hk.judul_kuis AS nama_evaluasi,
            hk.tanggal_pengerjaan AS tanggal,
            CONCAT(
                COALESCE((SELECT SUM(js.poin_diperoleh) FROM jawaban_soal js WHERE js.id_hasil = hk.id_hasil), 0),
                ' / ',
                COALESCE((SELECT SUM(js.poin_maksimal) FROM jawaban_soal js WHERE js.id_hasil = hk.id_hasil), 0)
            ) AS skor,
            CASE
                WHEN EXISTS (
                    SELECT 1 FROM jawaban_soal js
                    WHERE js.id_hasil = hk.id_hasil AND LOWER(js.tipe_soal) = 'essay' AND js.sudah_dinilai = 0
                ) THEN 'Menunggu Penilaian Essay'
                ELSE 'Selesai Dinilai'
            END AS status_evaluasi,
            COALESCE(NULLIF(hk.catatan_instruktur, ''), 'Tidak ada catatan') AS catatan
        FROM peserta p
        JOIN pengguna pg ON pg.username = p.username
        LEFT JOIN program pr ON p.id_program = pr.id_program
        INNER JOIN hasil_kuis hk ON hk.id_peserta = p.id_peserta
        WHERE p.id_peserta = $P{id_peserta}
        ]]>
    </queryString>

    <field name="id_peserta" class="java.lang.String"/>
    <field name="nik" class="java.lang.String"/>
    <field name="nama_lengkap" class="java.lang.String"/>
    <field name="kelas" class="java.lang.String"/>
    <field name="level_bahasa" class="java.lang.String"/>
    <field name="status_seleksi" class="java.lang.String"/>
    <field name="nama_program" class="java.lang.String"/>
    <field name="kategori" class="java.lang.String"/>
    <field name="nama_evaluasi" class="java.lang.String"/>
    <field name="tanggal" class="java.lang.String"/>
    <field name="skor" class="java.lang.String"/>
    <field name="status_evaluasi" class="java.lang.String"/>
    <field name="catatan" class="java.lang.String"/>

    <!-- Nomor urut yang hanya menghitung baris yang benar-benar dicetak (baris kosong tidak dihitung) -->
    <variable name="nomor" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[($F{nama_evaluasi} != null) ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="145">
            <staticText>
                <reportElement x="0" y="0" width="515" height="24" forecolor="#7A0000"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LPK YUUKI — TRAINING CENTER INDONESIA]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="25" width="515" height="18" forecolor="#444444"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[TRANSKRIP NILAI & LAPORAN HASIL BELAJAR PESERTA]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="48" width="515" height="2" forecolor="#7A0000"/>
            </line>

            <staticText>
                <reportElement x="0" y="60" width="95" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[ID Peserta]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="60" width="160" height="18"/>
                <textFieldExpression><![CDATA[": " + $F{id_peserta}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="275" y="60" width="85" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Program]]></text>
            </staticText>
            <textField>
                <reportElement x="365" y="60" width="150" height="18"/>
                <textFieldExpression><![CDATA[": " + $F{nama_program}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="82" width="95" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Nama Lengkap]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="82" width="160" height="18"/>
                <textFieldExpression><![CDATA[": " + $F{nama_lengkap}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="275" y="82" width="85" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Kelas / Level]]></text>
            </staticText>
            <textField>
                <reportElement x="365" y="82" width="150" height="18"/>
                <textFieldExpression><![CDATA[": " + $F{kelas} + " (" + $F{level_bahasa} + ")"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="104" width="95" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[NIK]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="104" width="160" height="18"/>
                <textFieldExpression><![CDATA[": " + $F{nik}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="275" y="104" width="85" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Status Seleksi]]></text>
            </staticText>
            <textField>
                <reportElement x="365" y="104" width="150" height="18"/>
                <textFieldExpression><![CDATA[": " + $F{status_seleksi}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="30" height="24" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="9"/></textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="30" y="0" width="75" height="24" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="9"/></textElement>
                <text><![CDATA[Kategori]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="105" y="0" width="145" height="24" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="9"/></textElement>
                <text><![CDATA[Materi / Judul Kuis]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="250" y="0" width="75" height="24" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="9"/></textElement>
                <text><![CDATA[Tanggal]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="325" y="0" width="65" height="24" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="9"/></textElement>
                <text><![CDATA[Nilai / Skor]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="390" y="0" width="125" height="24" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="9"/></textElement>
                <text><![CDATA[Status & Catatan]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="28">
            <!-- baris kosong (peserta belum punya data seleksi) tidak dicetak -->
            <printWhenExpression><![CDATA[$F{nama_evaluasi} != null]]></printWhenExpression>
            <textField>
                <reportElement x="0" y="2" width="30" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$V{nomor}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="30" y="2" width="75" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{kategori}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="105" y="2" width="145" height="24"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{nama_evaluasi}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="2" width="75" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{tanggal}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="325" y="2" width="65" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{skor}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="390" y="2" width="125" height="24"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{status_evaluasi} + " (" + $F{catatan} + ")"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="90">
            <!-- pesan ini hanya muncul bila tidak ada satu pun baris yang dicetak -->
            <staticText>
                <reportElement x="0" y="0" width="515" height="18" forecolor="#666666">
                    <printWhenExpression><![CDATA[$V{nomor} == 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <text><![CDATA[Belum ada data nilai seleksi atau hasil kuis untuk peserta ini.]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="20" width="175" height="18"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <text><![CDATA[Mengetahui, Bagian Akademik]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="68" width="175" height="18"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[( LPK Yuuki Indonesia )]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
