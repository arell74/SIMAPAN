                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER} + " dari "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="485" y="5" width="30" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ==================== KARTU RINGKASAN & PENGESAHAN ==================== -->
    <summary>
        <band height="125">
            <!-- Pesan jika belum ada nilai -->
