                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[KARTU HASIL STUDI]]></text>
            </staticText>
            <staticText>
                <reportElement x="378" y="33" width="125" height="11" forecolor="#F8B4B4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <text><![CDATA[Transkrip Nilai Peserta]]></text>
            </staticText>
            <textField>
                <reportElement x="378" y="45" width="125" height="11" forecolor="#FDE8E8"/>
