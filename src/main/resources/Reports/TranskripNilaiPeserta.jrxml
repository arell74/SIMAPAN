<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TranskripNilaiPeserta" language="java" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="32" bottomMargin="32"
              whenNoDataType="AllSectionsNoDetail">

    <!-- STYLE ZEBRA STRIPING UNTUK BARIS TABEL -->
    <style name="RowStyle" mode="Opaque" backcolor="#FFFFFF" fontName="SansSerif" fontSize="8.5">
        <box>
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{nomor} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#F8FAFC"/>
        </conditionalStyle>
    </style>

    <parameter name="id_peserta" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT
            p.id_peserta,
            p.nik,
            pg.nama_lengkap,
            p.kelas,
            p.level_bahasa,
            p.status_seleksi,
            COALESCE(pr.nama_program, '-') AS nama_program,
            'Tes Seleksi' AS kategori,
            s.jenis_seleksi AS nama_evaluasi,
            s.tanggal_seleksi AS tanggal,
            CAST(s.nilai AS CHAR) AS skor,
            s.status_hasil AS status_evaluasi,
            '-' AS catatan
        FROM peserta p
        JOIN pengguna pg ON pg.username = p.username
        LEFT JOIN program pr ON p.id_program = pr.id_program
        LEFT JOIN seleksi s ON s.id_peserta = p.id_peserta
        WHERE p.id_peserta = $P{id_peserta}

        UNION ALL

        SELECT
            p.id_peserta,
            p.nik,
            pg.nama_lengkap,
            p.kelas,
            p.level_bahasa,
            p.status_seleksi,
            COALESCE(pr.nama_program, '-') AS nama_program,
            'Kuis Kelas' AS kategori,
            hk.judul_kuis AS nama_evaluasi,
            hk.tanggal_pengerjaan AS tanggal,
            CONCAT(
                COALESCE((SELECT SUM(js.poin_diperoleh) FROM jawaban_soal js WHERE js.id_hasil = hk.id_hasil), 0),
                ' / ',
                COALESCE((SELECT SUM(js.poin_maksimal) FROM jawaban_soal js WHERE js.id_hasil = hk.id_hasil), 0)
            ) AS skor,
            CASE
                WHEN EXISTS (
                    SELECT 1 FROM jawaban_soal js
                    WHERE js.id_hasil = hk.id_hasil AND LOWER(js.tipe_soal) = 'essay' AND js.sudah_dinilai = 0
                ) THEN 'Menunggu Penilaian Essay'
                ELSE 'Selesai Dinilai'
            END AS status_evaluasi,
            COALESCE(NULLIF(hk.catatan_instruktur, ''), 'Tidak ada catatan') AS catatan
        FROM peserta p
        JOIN pengguna pg ON pg.username = p.username
        LEFT JOIN program pr ON p.id_program = pr.id_program
        INNER JOIN hasil_kuis hk ON hk.id_peserta = p.id_peserta
        WHERE p.id_peserta = $P{id_peserta}
        ]]>
    </queryString>

    <field name="id_peserta" class="java.lang.String"/>
    <field name="nik" class="java.lang.String"/>
    <field name="nama_lengkap" class="java.lang.String"/>
    <field name="kelas" class="java.lang.String"/>
    <field name="level_bahasa" class="java.lang.String"/>
    <field name="status_seleksi" class="java.lang.String"/>
    <field name="nama_program" class="java.lang.String"/>
    <field name="kategori" class="java.lang.String"/>
    <field name="nama_evaluasi" class="java.lang.String"/>
    <field name="tanggal" class="java.lang.String"/>
    <field name="skor" class="java.lang.String"/>
    <field name="status_evaluasi" class="java.lang.String"/>
    <field name="catatan" class="java.lang.String"/>

    <variable name="nomor" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[($F{nama_evaluasi} != null) ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>

    <!-- ==================== HEADER & KARTU BIODATA PESERTA ==================== -->
