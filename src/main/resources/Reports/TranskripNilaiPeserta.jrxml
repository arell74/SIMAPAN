                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No. Registrasi: " + $F{id_peserta}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="20" y="108" width="483" height="1" forecolor="#E2E8F0"/>
            </line>

            <!-- Baris Biodata 1 -->
            <staticText>
                <reportElement x="20" y="114" width="80" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                <text><![CDATA[Nama Lengkap]]></text>
            </staticText>
            <textField>
                <reportElement x="102" y="114" width="165" height="16" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[": " + $F{nama_lengkap}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="278" y="114" width="75" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                <text><![CDATA[Program]]></text>
