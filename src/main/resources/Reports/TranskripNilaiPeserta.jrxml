        <band height="218">
            <!-- 1. KARTU HEADER LPK YUUKI -->
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="0" width="515" height="74" backcolor="#7A0000" forecolor="#5A0000"/>
                <graphicElement><pen lineWidth="0.8" lineColor="#5A0000"/></graphicElement>
            </rectangle>

            <!-- Bingkai Putih Kecil untuk Logo agar Kontras -->
            <rectangle radius="6">
                <reportElement mode="Opaque" x="12" y="10" width="54" height="54" backcolor="#FFFFFF" forecolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="15" y="13" width="48" height="48"/>
                <imageExpression><![CDATA[new java.io.File("/home/arelssi/Downloads/yuuki-logo.png")]]></imageExpression>
            </image>

            <!-- Nama Lembaga di Banner Marun -->
            <staticText>
                <reportElement x="76" y="11" width="295" height="20" forecolor="#FFFFFF"/>
