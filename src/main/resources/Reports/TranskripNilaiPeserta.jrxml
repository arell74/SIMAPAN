                <textFieldExpression><![CDATA["Total Evaluasi Tercatat : " + $V{nomor} + " Item"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="12" y="65" width="250" height="24" forecolor="#64748B"/>
                <textElement><font size="7.5"/></textElement>
                <text><![CDATA[Transkrip ini sah sebagai bukti capaian belajar sementara peserta di LPK Yuuki Indonesia.]]></text>
            </staticText>

            <!-- Blok Pengesahan Bagian Akademik di Kanan -->
            <textField>
                <reportElement x="315" y="28" width="200" height="14" forecolor="#334155"/>
                <textElement textAlignment="Center"><font size="8.5"/></textElement>
                <textFieldExpression><![CDATA["Kuningan, " + new java.text.SimpleDateFormat("dd MMMM yyyy").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="315" y="42" width="200" height="14" forecolor="#334155"/>
                <textElement textAlignment="Center"><font size="8.5"/></textElement>
                <text><![CDATA[Mengetahui, Bagian Akademik]]></text>
            </staticText>
            <line>
                <reportElement x="340" y="92" width="150" height="1" forecolor="#334155"/>
            </line>
            <staticText>
                <reportElement x="315" y="96" width="200" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Center"><font size="8.5" isBold="true"/></textElement>
                <text><![CDATA[( LPK Yuuki Indonesia )]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>