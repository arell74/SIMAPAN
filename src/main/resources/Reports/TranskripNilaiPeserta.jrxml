            <textField>
                <reportElement x="355" y="114" width="148" height="16" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[": " + $F{nama_program}]]></textFieldExpression>
            </textField>

            <!-- Baris Biodata 2 -->
            <staticText>
                <reportElement x="20" y="136" width="80" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                <text><![CDATA[NIK]]></text>
            </staticText>
            <textField>
                <reportElement x="102" y="136" width="165" height="16" forecolor="#334155"/>
