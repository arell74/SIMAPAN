                <graphicElement><pen lineWidth="0.8" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>

            <!-- Strip Aksen Marun di Sisi Kiri Kartu Biodata -->
            <rectangle radius="3">
                <reportElement mode="Opaque" x="8" y="92" width="4" height="88" backcolor="#7A0000" forecolor="#7A0000"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <!-- Header Kecil dalam Kartu Biodata -->
            <staticText>
                <reportElement x="20" y="91" width="250" height="14" forecolor="#7A0000"/>
                <textElement verticalAlignment="Middle">
                    <font size="8.5" isBold="true"/>
                </textElement>
                <text><![CDATA[IDENTITAS PESERTA PELATIHAN]]></text>
            </staticText>
            <textField>
                <reportElement x="330" y="91" width="173" height="14" forecolor="#64748B"/>
