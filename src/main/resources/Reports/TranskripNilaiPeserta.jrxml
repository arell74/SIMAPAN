                <text><![CDATA[Training Center & Persiapan Pemagangan Jepang]]></text>
            </staticText>
            <staticText>
                <reportElement x="76" y="46" width="295" height="14" forecolor="#F8B4B4"/>
                <textElement verticalAlignment="Middle">
                    <font size="7.5"/>
                </textElement>
                <text><![CDATA[Jl. Raya Kuningan — Jawa Barat  |  SIMAPAN Academic Portal]]></text>
            </staticText>

            <!-- Pill Badge Kanan Atas -->
            <rectangle radius="5">
