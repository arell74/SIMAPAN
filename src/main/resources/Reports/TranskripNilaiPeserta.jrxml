    <!-- ==================== BARIS DATA NILAI ==================== -->
    <detail>
        <band height="26" splitType="Prevent">
            <printWhenExpression><![CDATA[$F{nama_evaluasi} != null]]></printWhenExpression>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="0" y="0" width="28" height="26"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{nomor}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="28" y="0" width="72" height="26" forecolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{kategori}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="100" y="0" width="150" height="26"/>
                <textElement verticalAlignment="Middle">
                    <font size="8.5" isBold="true"/>
                    <paragraph leftIndent="6" rightIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_evaluasi}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="250" y="0" width="75" height="26" forecolor="#475569"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tanggal}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="325" y="0" width="62" height="26" forecolor="#0F172A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{skor}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="387" y="0" width="128" height="26" forecolor="#334155"/>
                <textElement verticalAlignment="Middle">
                    <font size="7.5"/>
                    <paragraph leftIndent="5" rightIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status_evaluasi} + "\n(" + $F{catatan} + ")"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ==================== FOOTER HALAMAN ==================== -->
    <pageFooter>
