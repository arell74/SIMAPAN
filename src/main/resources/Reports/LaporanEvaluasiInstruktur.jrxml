<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="LaporanEvaluasiInstruktur" language="java" orientation="Landscape"
              pageWidth="842" pageHeight="595" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <!-- STYLE ZEBRA STRIPING -->
    <style name="RowStyle" mode="Opaque" backcolor="#FFFFFF" fontName="SansSerif" fontSize="8">
        <box>
            <pen lineWidth="0.5" lineColor="#CBD5E1"/>
        </box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#F8FAFC"/>
        </conditionalStyle>
    </style>

    <!-- PARAMETER IDENTITAS & RINGKASAN -->
    <parameter name="nama_instruktur" class="java.lang.String"/>
    <parameter name="id_instruktur" class="java.lang.String"/>
    <parameter name="kelas_diampu" class="java.lang.String"/>
    <parameter name="spesialisasi" class="java.lang.String"/>
    <parameter name="filter_periode" class="java.lang.String"/>
    <parameter name="filter_materi" class="java.lang.String"/>
    <parameter name="total_peserta" class="java.lang.String"/>
    <parameter name="kehadiran_kelas" class="java.lang.String"/>
    <parameter name="rata_rata_nilai" class="java.lang.String"/>
    <parameter name="perlu_perhatian" class="java.lang.String"/>

    <!-- FIELD BERDASARKAN INDEX KOLOM JTABLE (COLUMN_0 s/d COLUMN_10) -->
    <field name="COLUMN_0" class="java.lang.Object"/>
    <field name="COLUMN_1" class="java.lang.Object"/>
    <field name="COLUMN_2" class="java.lang.Object"/>
    <field name="COLUMN_3" class="java.lang.Object"/>
    <field name="COLUMN_4" class="java.lang.Object"/>
    <field name="COLUMN_5" class="java.lang.Object"/>
    <field name="COLUMN_6" class="java.lang.Object"/>
    <field name="COLUMN_7" class="java.lang.Object"/>
    <field name="COLUMN_8" class="java.lang.Object"/>
    <field name="COLUMN_9" class="java.lang.Object"/>
    <field name="COLUMN_10" class="java.lang.Object"/>

    <!-- ==================== KOP SURAT & RINGKASAN KPI ==================== -->
    <title>
        <band height="205">
            <!-- Logo LPK Yuuki -->
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="2" width="62" height="62"/>
                <imageExpression><![CDATA[new java.io.File("/home/arelssi/Downloads/yuuki-logo.png")]]></imageExpression>
            </image>

            <!-- Judul Kop -->
            <staticText>
                <reportElement x="72" y="2" width="490" height="23" forecolor="#7A0000"/>
                <textElement verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LPK YUUKI — TRAINING CENTER INDONESIA]]></text>
            </staticText>
            <staticText>
                <reportElement x="72" y="25" width="490" height="15" forecolor="#334155"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Laporan Evaluasi Akademik, Nilai Materi & Rekap Kehadiran Peserta Pemagangan]]></text>
            </staticText>
            <staticText>
                <reportElement x="72" y="41" width="490" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Jl. Raya Kuningan — Jawa Barat, Indonesia  |  Sistem Informasi Manajemen Pemagangan (SIMAPAN)]]></text>
            </staticText>

            <!-- Kotak Info Filter di Kanan Atas -->
            <rectangle radius="4">
                <reportElement mode="Opaque" x="572" y="4" width="190" height="58" backcolor="#FFF5F5" forecolor="#7A0000"/>
                <graphicElement><pen lineWidth="0.8" lineColor="#7A0000"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="572" y="7" width="190" height="13" forecolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[PARAMETER LAPORAN]]></text>
            </staticText>
            <textField>
                <reportElement x="580" y="21" width="174" height="13" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA["Periode : " + $P{filter_periode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="580" y="34" width="174" height="13" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA["Materi  : " + $P{filter_materi}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="580" y="47" width="174" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA["Dicetak : " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <!-- Garis Pembatas Kop -->
            <line>
                <reportElement x="0" y="69" width="762" height="2" forecolor="#7A0000"/>
                <graphicElement><pen lineWidth="2.0" lineColor="#7A0000"/></graphicElement>
            </line>
            <line>
                <reportElement x="0" y="73" width="762" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#CBD5E1"/></graphicElement>
            </line>

            <!-- Banner Judul Dokumen -->
            <staticText>
                <reportElement x="0" y="79" width="762" height="20" forecolor="#0F172A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN EVALUASI HASIL BELAJAR & KEHADIRAN PESERTA KELAS]]></text>
            </staticText>

            <!-- Blok Identitas Instruktur -->
            <rectangle radius="3">
                <reportElement mode="Opaque" x="0" y="103" width="762" height="36" backcolor="#F8FAFC" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="10" y="106" width="360" height="15" forecolor="#1E293B"/>
                <textElement verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Instruktur Pendamping : " + $P{nama_instruktur} + " (" + $P{id_instruktur} + ")"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="10" y="121" width="360" height="15" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Spesialisasi / Sertifikasi : " + $P{spesialisasi}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="106" width="350" height="15" forecolor="#1E293B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Kelas Bimbingan : " + $P{kelas_diampu}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="400" y="121" width="350" height="15" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <text><![CDATA[Standar Kelulusan Minimum (KKM) : 70]]></text>
            </staticText>

            <!-- 4 KARTU RINGKASAN KPI -->
            <!-- Card 1: Total Peserta -->
            <rectangle radius="4">
                <reportElement mode="Opaque" x="0" y="146" width="182" height="48" backcolor="#FFFFFF" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.7" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="150" width="162" height="13" forecolor="#64748B"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[TOTAL PESERTA KELAS]]></text>
            </staticText>
            <textField>
                <reportElement x="10" y="164" width="162" height="24" forecolor="#7A0000"/>
                <textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{total_peserta} + " Peserta"]]></textFieldExpression>
            </textField>

            <!-- Card 2: Kehadiran Kelas -->
            <rectangle radius="4">
                <reportElement mode="Opaque" x="193" y="146" width="182" height="48" backcolor="#FFFFFF" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.7" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="203" y="150" width="162" height="13" forecolor="#64748B"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[RATA-RATA KEHADIRAN]]></text>
            </staticText>
            <textField>
                <reportElement x="203" y="164" width="162" height="24" forecolor="#15803D"/>
                <textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{kehadiran_kelas}]]></textFieldExpression>
            </textField>

            <!-- Card 3: Rata-rata Nilai -->
            <rectangle radius="4">
                <reportElement mode="Opaque" x="387" y="146" width="182" height="48" backcolor="#FFFFFF" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.7" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="397" y="150" width="162" height="13" forecolor="#64748B"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[RATA-RATA NILAI KELAS]]></text>
            </staticText>
            <textField>
                <reportElement x="397" y="164" width="162" height="24" forecolor="#1E3A8A"/>
                <textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{rata_rata_nilai}]]></textFieldExpression>
            </textField>

            <!-- Card 4: Perlu Perhatian -->
            <rectangle radius="4">
                <reportElement mode="Opaque" x="580" y="146" width="182" height="48" backcolor="#FFFFFF" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.7" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="590" y="150" width="162" height="13" forecolor="#64748B"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[PERLU PERHATIAN (< 70)]]></text>
            </staticText>
            <textField>
                <reportElement x="590" y="164" width="162" height="24" forecolor="#D97706"/>
                <textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{perlu_perhatian} + " Peserta"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ==================== HEADER TABEL ==================== -->
    <columnHeader>
        <band height="28">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="28" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="28" y="0" width="58" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[ID Peserta]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="86" y="0" width="186" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Nama Lengkap Peserta]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="272" y="0" width="55" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Bab 4]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="327" y="0" width="68" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Percakapan]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="395" y="0" width="55" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Bab 5]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="450" y="0" width="62" height="28" forecolor="#FFFFFF" backcolor="#5C0000"/>
                <box><pen lineWidth="0.5" lineColor="#3F0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Rata-rata]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="512" y="0" width="48" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Hadir]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="560" y="0" width="48" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Izin]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="608" y="0" width="48" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Alpha]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="656" y="0" width="106" height="28" forecolor="#FFFFFF" backcolor="#7A0000"/>
                <box><pen lineWidth="0.5" lineColor="#5A0000"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Status Evaluasi]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ==================== BARIS DATA PESERTA ==================== -->
    <detail>
        <band height="24" splitType="Prevent">
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="0" y="0" width="28" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_0})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="28" y="0" width="58" height="24" forecolor="#7A0000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_1})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="86" y="0" width="186" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="8.5" isBold="true"/>
                    <paragraph leftIndent="6" rightIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_2})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="272" y="0" width="55" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_3})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="327" y="0" width="68" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_4})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="395" y="0" width="55" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_5})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="450" y="0" width="62" height="24" forecolor="#0F172A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_6})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="512" y="0" width="48" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_7})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="560" y="0" width="48" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_8})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="608" y="0" width="48" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_9})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="RowStyle" stretchType="RelativeToBandHeight" x="656" y="0" width="106" height="24" forecolor="#15803D"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($F{COLUMN_10})]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ==================== FOOTER HALAMAN ==================== -->
    <pageFooter>
        <band height="22">
            <line>
                <reportElement x="0" y="2" width="762" height="1" forecolor="#E2E8F0"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="450" height="15" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <text><![CDATA[SIMAPAN — Laporan Resmi Evaluasi Kelas LPK Yuuki Indonesia]]></text>
            </staticText>
            <textField>
                <reportElement x="580" y="5" width="145" height="15" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER} + " dari "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="725" y="5" width="37" height="15" forecolor="#64748B"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ==================== TANDA TANGAN ==================== -->
    <summary>
        <band height="115">
            <!-- Catatan Keterangan di Kiri -->
            <rectangle radius="4">
                <reportElement mode="Opaque" x="0" y="14" width="310" height="52" backcolor="#F8FAFC" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="19" width="286" height="14" forecolor="#1E293B"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Keterangan Status Evaluasi:]]></text>
            </staticText>
            <staticText>
                <reportElement x="12" y="34" width="286" height="28" forecolor="#64748B"/>
                <textElement><font size="7.5"/></textElement>
                <text><![CDATA[• Aman : Nilai rata-rata >= 70 dan tingkat kehadiran memenuhi syarat.
• Perlu Perhatian : Nilai rata-rata < 70, perlu bimbingan tambahan.]]></text>
            </staticText>

            <!-- Blok Tanda Tangan Instruktur -->
            <textField>
                <reportElement x="532" y="14" width="230" height="15" forecolor="#334155"/>
                <textElement textAlignment="Center"><font size="8.5"/></textElement>
                <textFieldExpression><![CDATA["Kuningan, " + new java.text.SimpleDateFormat("dd MMMM yyyy").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="532" y="29" width="230" height="15" forecolor="#334155"/>
                <textElement textAlignment="Center"><font size="8.5"/></textElement>
                <text><![CDATA[Instruktur Pengampu Kelas,]]></text>
            </staticText>
            <line>
                <reportElement x="567" y="88" width="160" height="1" forecolor="#334155"/>
            </line>
            <textField>
                <reportElement x="532" y="92" width="230" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Center"><font size="8.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["( " + $P{nama_instruktur} + " )"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>